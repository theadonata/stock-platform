# Pins dependency resolution to legacy (npm 6 -era) peer-dep behavior. Needed
# because @vitest/coverage-v8's peer graph on vitest trips a known npm 9.x
# arborist bug ("Cannot read properties of null (reading 'edgesOut')") under
# strict peer resolution; this setting sidesteps it and keeps `npm ci`
# reproducible across npm versions (local dev vs. CI's runner-provided npm).
legacy-peer-deps=true
